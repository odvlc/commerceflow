<?xml version="1.0" ?>
<!--
Assembles real cross-service test fixtures and opt-in AI evaluation without becoming a deployed
commerce service.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.commerceflow</groupId>
        <artifactId>commerceflow</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>workflow-tests</artifactId>
    <!-- The test harness depends on real service modules so integration checks cross their actual
         boundaries. -->
    <dependencies>
        <dependency>
            <groupId>com.commerceflow</groupId>
            <artifactId>ai-service</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.commerceflow</groupId>
            <artifactId>notification-service</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.commerceflow</groupId>
            <artifactId>api-gateway</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.commerceflow</groupId>
            <artifactId>cart-service</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.commerceflow</groupId>
            <artifactId>catalog-service</artifactId>
            <version>0.1.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.commerceflow</groupId>
            <artifactId>order-service</artifactId>
            <version>0.1.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.commerceflow</groupId>
            <artifactId>inventory-service</artifactId>
            <version>0.1.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.commerceflow</groupId>
            <artifactId>payment-service</artifactId>
            <version>0.1.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <version>2.2.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <profiles>
        <profile>
            <id>ai-evaluation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/AiEvaluationIT.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <commerceflow.root>${maven.multiModuleProjectDirectory}</commerceflow.root>
                                <redis.server.path>
                                    ${maven.multiModuleProjectDirectory}/.cache/tools/redis-8.10.2/src/redis-server
                                </redis.server.path>
                                <elasticsearch.home.path>
                                    ${maven.multiModuleProjectDirectory}/.cache/tools/elasticsearch-9.4.5
                                </elasticsearch.home.path>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
