<?xml version="1.0" ?>
<!--
Builds wire DTOs only; keep runtime infrastructure and persistence entities out of this shared
contract module.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.commerceflow</groupId>
        <artifactId>commerceflow</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>contracts</artifactId>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <!-- Test assertions are not part of the published DTO library runtime dependency surface. -->
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
