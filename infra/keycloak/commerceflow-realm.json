{
  "realm": "commerceflow",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "CUSTOMER"
      },
      {
        "name": "ADMIN"
      },
      {
        "name": "SUPPORT"
      }
    ]
  },
  "users": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "username": "alice",
      "enabled": true,
      "email": "alice@example.invalid",
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "Alice",
      "realmRoles": [
        "CUSTOMER"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "local-alice-only",
          "temporary": false
        }
      ]
    },
    {
      "id": "00000000-0000-0000-0000-000000000002",
      "username": "bob",
      "enabled": true,
      "email": "bob@example.invalid",
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "Bob",
      "realmRoles": [
        "CUSTOMER"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "local-bob-only",
          "temporary": false
        }
      ]
    },
    {
      "id": "00000000-0000-0000-0000-000000000003",
      "username": "admin",
      "enabled": true,
      "email": "admin@example.invalid",
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "Admin",
      "realmRoles": [
        "ADMIN"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "local-admin-only",
          "temporary": false
        }
      ]
    },
    {
      "id": "00000000-0000-0000-0000-000000000004",
      "username": "support",
      "enabled": true,
      "email": "support@example.invalid",
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "Support",
      "realmRoles": [
        "SUPPORT"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "local-support-only",
          "temporary": false
        }
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "commerceflow.internal",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    },
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "commerceflow-web",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:3000/*"
      },
      "defaultClientScopes": [
        "basic"
      ],
      "protocolMappers": [
        {
          "name": "commerceflow-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "commerceflow-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "commerceflow-service",
      "publicClient": false,
      "secret": "${SERVICE_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "commerceflow.internal",
        "basic"
      ],
      "protocolMappers": [
        {
          "name": "commerceflow-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "commerceflow-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}
