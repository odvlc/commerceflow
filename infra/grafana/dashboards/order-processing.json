{
  "title": "Order Processing",
  "uid": "cf-order-processing",
  "schemaVersion": 40,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Completed orders/s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "commerceflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(result)(rate(commerceflow_orders_completed_total[1m]))",
          "refId": "A",
          "legendFormat": "{{instance}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Saga mean duration seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "commerceflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(result)(rate(commerceflow_saga_completion_seconds_sum[5m]))/sum by(result)(rate(commerceflow_saga_completion_seconds_count[5m]))",
          "refId": "A",
          "legendFormat": "{{instance}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Pending outbox events",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "commerceflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "commerceflow_outbox_pending",
          "refId": "A",
          "legendFormat": "{{instance}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Reservation failures/s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "commerceflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(commerceflow_inventory_reservations_total{result=\"REJECTED\"}[1m])",
          "refId": "A",
          "legendFormat": "{{instance}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Payment outcomes/s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "commerceflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(result)(rate(commerceflow_payment_outcomes_total[1m]))",
          "refId": "A",
          "legendFormat": "{{instance}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Kafka processing seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "commerceflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(commerceflow_kafka_processing_seconds_sum[1m])/rate(commerceflow_kafka_processing_seconds_count[1m])",
          "refId": "A",
          "legendFormat": "{{instance}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Duplicate messages/s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "commerceflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(commerceflow_kafka_duplicates_total[1m])",
          "refId": "A",
          "legendFormat": "{{instance}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
