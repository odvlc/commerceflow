{
  "title": "Service Health",
  "uid": "cf-service-health",
  "schemaVersion": 40,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests/s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "commerceflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(instance)(rate(http_server_requests_seconds_count[1m]))",
          "refId": "A",
          "legendFormat": "{{instance}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "HTTP p95 seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "commerceflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by(le,instance)(rate(http_server_requests_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "{{instance}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "HTTP 5xx/s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "commerceflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(instance)(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))",
          "refId": "A",
          "legendFormat": "{{instance}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "JVM heap bytes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "commerceflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(instance)(jvm_memory_used_bytes{area=\"heap\"})",
          "refId": "A",
          "legendFormat": "{{instance}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Live JVM threads",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "commerceflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "jvm_threads_live_threads",
          "refId": "A",
          "legendFormat": "{{instance}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Active database connections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "commerceflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active",
          "refId": "A",
          "legendFormat": "{{instance}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Kafka consumer lag",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "commerceflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "kafka_consumer_fetch_manager_records_lag_max",
          "refId": "A",
          "legendFormat": "{{instance}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Cache hits and misses",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "commerceflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(__name__)(rate({__name__=~\"commerceflow_cache_(hits|misses)_total\"}[1m]))",
          "refId": "A",
          "legendFormat": "{{instance}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "Search mean latency seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "commerceflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(commerceflow_search_query_seconds_sum[1m])/rate(commerceflow_search_query_seconds_count[1m])",
          "refId": "A",
          "legendFormat": "{{instance}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
