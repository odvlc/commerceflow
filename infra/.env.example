# Copy only for local development; each database password belongs to its service and must stay
# consistent with provisioning.
# LOCAL DEVELOPMENT ONLY. Defaults are deliberately public and never for deployment.
POSTGRES_PASSWORD=local-postgres-only
CATALOG_DB_PASSWORD=local-catalog-only
ORDER_DB_PASSWORD=local-order-only
INVENTORY_DB_PASSWORD=local-inventory-only
PAYMENT_DB_PASSWORD=local-payment-only
NOTIFICATION_DB_PASSWORD=local-notification-only
KEYCLOAK_DB_PASSWORD=local-keycloak-only
KEYCLOAK_ADMIN_PASSWORD=local-admin-only
# This service identity must match Keycloak provisioning and authenticated monitoring configuration.
SERVICE_CLIENT_SECRET=local-service-only
GRAFANA_ADMIN_PASSWORD=local-grafana-only

# Local AI service owns a separate database.
AI_DB_PASSWORD=local-ai-only
# Optional local AI; compose-up.sh selects AI_ENABLED and the runtime URL per invocation.
# Native Ollama stays on loopback; Docker Desktop reachability is checked from a temporary container.
AI_HOST_MODEL_URL=http://host.docker.internal:11434
AI_MODEL_PREPARE_TIMEOUT=1800
