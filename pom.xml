<?xml version="1.0" ?>
<!--
Aggregates independently deployable modules and centralizes Java, Boot BOM and test plugin versions;
service dependencies inherit these choices.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>
    <groupId>com.commerceflow</groupId>
    <artifactId>commerceflow</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>CommerceFlow</name>
    <modules>
        <module>contracts</module>
        <module>service-support</module>
        <module>catalog-service</module>
        <module>inventory-service</module>
        <module>order-service</module>
        <module>payment-service</module>
        <module>cart-service</module>
        <module>api-gateway</module>
        <module>notification-service</module>
        <module>ai-service</module>
        <module>workflow-tests</module>
    </modules>
    <properties>
        <java.version>25</java.version>
        <springdoc.version>3.1.1</springdoc.version>
        <postgres.binaries.version>18.6.0</postgres.binaries.version>
    </properties>
    <!-- Pin shared module/test dependencies here; Spring versions come from the inherited Boot
         dependency management. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.commerceflow</groupId>
                <artifactId>contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.commerceflow</groupId>
                <artifactId>service-support</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>io.zonky.test</groupId>
                <artifactId>embedded-postgres</artifactId>
                <version>2.2.2</version>
            </dependency>
            <dependency>
                <groupId>io.zonky.test.postgres</groupId>
                <artifactId>embedded-postgres-binaries-bom</artifactId>
                <version>${postgres.binaries.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <argLine>-XX:+EnableDynamicAgentLoading</argLine>
                        <systemPropertyVariables>
                            <redis.server.path>
                                ${maven.multiModuleProjectDirectory}/.cache/tools/redis-8.10.2/src/redis-server
                            </redis.server.path>
                            <elasticsearch.home.path>
                                ${maven.multiModuleProjectDirectory}/.cache/tools/elasticsearch-9.4.5
                            </elasticsearch.home.path>
                            <keycloak.home.path>${maven.multiModuleProjectDirectory}/.cache/tools/keycloak-26.8.1
                            </keycloak.home.path>
                            <commerceflow.root>${maven.multiModuleProjectDirectory}</commerceflow.root>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <!-- Integration-test execution and verification belong to the verify lifecycle;
                         compilation alone does not run these tests. -->
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
    <profiles>
        <profile>
            <id>mac-arm-postgres</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>io.zonky.test.postgres</groupId>
                    <artifactId>embedded-postgres-binaries-darwin-arm64v8</artifactId>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
